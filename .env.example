# ============================================================
# OccasionPro — Environment Variables
# Copy this file to .env.local (never commit .env.local)
# ============================================================

# ── APP ──────────────────────────────────────────────────────
APP_ENV=development                         # development | staging | production
APP_URL=http://localhost:3000               # Public URL of the web app
API_URL=http://localhost:4000               # NestJS API URL
APP_DOMAIN=occasionpro.in                  # Production domain

# ── SUPABASE ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── CLOUDFLARE ───────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
CLOUDFLARE_R2_BUCKET_NAME=occasionpro-assets
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_PUBLIC_URL=https://assets.occasionpro.in

# ── RAZORPAY ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Razorpay Route (for vendor payouts)
RAZORPAY_ROUTE_ACCOUNT_ID=your-route-account-id

# ── AI / LiteLLM ─────────────────────────────────────────────
LITELLM_API_URL=http://localhost:8000       # Self-hosted LiteLLM
LITELLM_API_KEY=your-litellm-api-key
# Optional: Cloudflare AI Gateway proxy
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/your-account/occasionpro

# Underlying provider keys (routed through LiteLLM)
OPENAI_API_KEY=sk-...                       # Optional
ANTHROPIC_API_KEY=sk-ant-...               # Optional
GEMINI_API_KEY=...                         # Optional

# ── BREVO (Email) ────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@occasionpro.in
BREVO_SENDER_NAME=OccasionPro

# ── ELECTRIC SQL (Offline Sync) ──────────────────────────────
ELECTRIC_SERVICE_URL=http://localhost:5133  # Self-hosted ElectricSQL
ELECTRIC_SECRET=your-electric-secret

# ── INNGEST (Workflow Automation) ────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ── FLAGSMITH (Feature Flags) ────────────────────────────────
FLAGSMITH_SERVER_SIDE_KEY=your-flagsmith-key
NEXT_PUBLIC_FLAGSMITH_CLIENT_KEY=your-flagsmith-client-key
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/  # or self-hosted

# ── MONITORING (GlitchTip) ───────────────────────────────────
GLITCHTIP_DSN=https://your-key@glitchtip.yourdomain.com/1
NEXT_PUBLIC_GLITCHTIP_DSN=https://your-key@glitchtip.yourdomain.com/1

# ── AUTH ────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
# Google OAuth (for Company Admin, Event Manager, Team Member, Client portals)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── API INTERNAL ────────────────────────────────────────────
API_SECRET_KEY=your-internal-api-secret    # For web → api auth
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=7d

# ── REDIS (Caching / BullMQ queues) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── WHITE LABEL ──────────────────────────────────────────────
# Populated per tenant at runtime via Cloudflare KV
# WHITE_LABEL_TENANT_ID is injected by Cloudflare Worker on custom domain requests
