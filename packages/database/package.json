{
  "name": "@occasionpro/database",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase client, TypeScript types, and database utilities for OccasionPro",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@supabase/ssr": "^0.5.0"
  },
  "devDependencies": {
    "@occasionpro/config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.2.0",
    "typescript": "5.5.4",
    "supabase": "^1.192.0"
  }
}
