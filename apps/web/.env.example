# ============================================================
# OccasionPro Web (Next.js) — Environment Variables
# Copy to .env.local and fill in values before running locally.
# Never commit .env.local to version control.
#
# NEXT_PUBLIC_* vars are inlined into the browser bundle.
# Server-only vars (no prefix) stay on the server.
# ============================================================

# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the NestJS API server
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Use Supabase local dev keys from `supabase start` output
NEXT_PUBLIC_SUPABASE_URL=https://lndcqdnsllfcnkidhtem.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── App ──────────────────────────────────────────────────────────────────────
# The canonical public URL of this Next.js app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ─── Short Links ──────────────────────────────────────────────────────────────
# Base URL shown in the short links UI
NEXT_PUBLIC_SHORT_LINK_BASE=https://links.occasionpro.in

# ─── Payments ─────────────────────────────────────────────────────────────────
# Razorpay public key (safe to expose — used in the Checkout.js widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# ─── Error Monitoring ───────────────────────────────────────────────────────
# Sentry/GlitchTip DSN — leave blank to disable error reporting
NEXT_PUBLIC_SENTRY_DSN=
