{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npx -y pnpm@9.15.9 turbo build --filter=@occasionpro/web",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && npx -y pnpm@9.15.9 install --no-frozen-lockfile",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.occasionpro.in/api/$1"
    }
  ]
}
