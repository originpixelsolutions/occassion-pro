# ============================================================
# OccasionPro API — Environment Variables
# Copy to .env and fill in real values before running locally.
# Never commit .env to version control.
# ============================================================

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URLs (used in email links, OAuth callbacks, CORS)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# ── Supabase ──────────────────────────────────────────────────────────────────
# Local dev: `supabase start` prints these values
SUPABASE_URL=https://lndcqdnsllfcnkidhtem.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SERVICE_KEY is an alias used in some modules — keep in sync
SUPABASE_SERVICE_KEY=your-service-role-key
# JWT secret must match the one in supabase/config.toml [auth] jwt_secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# ── Security ──────────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM field-level encryption (PII, payment tokens)
FIELD_ENCRYPTION_KEY=change-me-32-bytes-hex-0000000000
# Gateway-level encryption key (internal service-to-service)
GATEWAY_ENCRYPTION_KEY=change-me-gateway-key-32-bytes-00
# Secret used to sign internal webhook calls (timing-safe HMAC)
INTERNAL_WEBHOOK_SECRET=change-in-production

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Global: requests per 60-second window per IP
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Route all AI calls through LiteLLM proxy (recommended for cost control)
LITELLM_API_URL=http://localhost:8000
LITELLM_API_KEY=your-litellm-api-key

# Default model used for intelligence engine, proposal generation, risk scoring
# Options: gpt-4o | gpt-4o-mini | claude-3-5-sonnet | gemini-1.5-pro
OPENAI_MODEL=gpt-4o

# Underlying provider keys (only needed if NOT routing through LiteLLM)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Optional: Cloudflare AI Gateway for unified observability
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/your-account/occasionpro

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Razorpay Route — for vendor payouts
RAZORPAY_ROUTE_ACCOUNT_ID=your-route-account-id

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret
CASHFREE_ENV=TEST

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ── Email (Brevo / SendinBlue) ────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@occasionpro.in
BREVO_SENDER_NAME=OccasionPro

# Resend (alternative email provider)
RESEND_API_KEY=re_your-resend-api-key

# ── SMS (Fast2SMS) ────────────────────────────────────────────────────────────
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_SENDER_ID=OPRO

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Meta Cloud API (preferred for production)
WHATSAPP_META_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
CLOUDFLARE_R2_BUCKET_NAME=occasionpro-assets
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_PUBLIC_URL=https://assets.occasionpro.in

# ── Short Links ───────────────────────────────────────────────────────────────
SHORT_LINK_DOMAIN=links.occasionpro.in
SHORT_LINK_BASE_URL=https://links.occasionpro.in

# ── Monitoring (GlitchTip / Sentry) ──────────────────────────────────────────
GLITCHTIP_DSN=https://your-key@glitchtip.yourdomain.com/1

# ── Feature Flags (Flagsmith) ─────────────────────────────────────────────────
FLAGSMITH_SERVER_SIDE_KEY=your-flagsmith-server-key
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/

# ── Workflow Automation (Inngest) ─────────────────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ── Offline Sync (ElectricSQL) ────────────────────────────────────────────────
ELECTRIC_SERVICE_URL=http://localhost:5133
ELECTRIC_SECRET=your-electric-secret

# ── Push Notifications (Expo) ────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=your-expo-access-token

# ─── Error Monitoring ───────────────────────────────────────────────────────
# Sentry/GlitchTip DSN — leave blank to disable error reporting
SENTRY_DSN=
