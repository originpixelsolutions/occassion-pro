{
  "name": "@occasionpro/api",
  "version": "0.1.0",
  "private": true,
  "description": "OccasionPro NestJS backend API",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/cache-manager": "^2.3.0",
    "cache-manager": "^5.7.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "@occasionpro/database": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "@supabase/ssr": "^0.5.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ioredis": "^5.4.1",
    "@nestjs/bullmq": "^10.2.0",
    "bullmq": "^5.13.0",
    "fastify": "^4.29.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/compress": "^7.0.3",
    "razorpay": "^2.9.6",
    "nodemailer": "^6.9.15",
    "handlebars": "^4.7.8",
    "dayjs": "^1.11.13",
    "zod": "^3.23.8",
    "uuid": "^10.0.0",
    "qrcode": "^1.5.4",
    "pdf-lib": "^1.17.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@occasionpro/config": "workspace:*",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  }
}
