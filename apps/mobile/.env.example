# ============================================================
# OccasionPro Mobile (Expo / React Native) — Environment Variables
# Copy to .env and fill in values before running locally.
# Never commit .env to version control.
#
# EXPO_PUBLIC_* vars are bundled into the app and visible to the client.
# They must NOT contain secrets.
# ============================================================

# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the NestJS API server
# For Android emulator use: http://10.0.2.2:4000
# For iOS simulator use: http://localhost:4000
# For physical device: use your LAN IP, e.g. http://192.168.1.x:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# ─── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://lndcqdnsllfcnkidhtem.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
